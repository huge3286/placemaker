<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Citymaker UI mock host: runs the REAL engine-free Core (recipes, composer, every registered
    layer) on modern .NET and serves the browser harness in ../ (UI/mock). Lives under UI/ so the
    main mod csproj (which excludes UI\**) never compiles it.
      dotnet run - -port 5123 -root <UI/mock>
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Citymaker.MockHost</AssemblyName>
    <!-- net9.0 as specified, but run on whatever newer runtime is installed (e.g. only .NET 10). -->
    <RollForward>Major</RollForward>
    <RootNamespace>Citymaker.MockHost</RootNamespace>
    <NoWarn>$(NoWarn);CS1591;CS0649</NoWarn>
    <ManagedPath Condition="'$(ManagedPath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Cities Skylines II\Cities2_Data\Managed</ManagedPath>
    <!-- The repo-wide .gitignore ignores bin/ and obj/ already. -->
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\..\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <Reference Include="Unity.Mathematics"><HintPath>$(ManagedPath)\Unity.Mathematics.dll</HintPath></Reference>
  </ItemGroup>
</Project>
