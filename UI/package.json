{
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node tools/extract-lang.js && webpack",
    "dev": "webpack --watch",
    "lang": "node tools/extract-lang.js",
    "lint:css": "node tools/css-lint.js build",
    "mock:build": "webpack --config mock/webpack.config.js",
    "mock": "node mock/run.js",
    "test:ui": "node mock/run.js --test"
  },
  "exclude": [
    "node_modules",
    "build"
  ],
  "dependencies": {
    "classnames": "2.3.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "18.0.26",
    "@types/react-dom": "18.0.9",
    "css-loader": "6.7.2",
    "mini-css-extract-plugin": "2.7.0",
    "sass": "^1.69.5",
    "sass-loader": "13.2.0",
    "style-loader": "^3.3.3",
    "swc-loader": "0.2.3",
    "terser-webpack-plugin": "^5.3.10",
    "ts-loader": "^9.5.1",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "typescript": "4.8.4",
    "webpack": "5.97.1",
    "webpack-cli": "4.10.0"
  },
  "name": "citymaker-ui",
  "private": true,
  "version": "0.1.0"
}
